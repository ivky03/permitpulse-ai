# Optional. Public Socrata requests work without a token but have lower limits.
NYC_OPEN_DATA_APP_TOKEN=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERMITPULSE_API_URL=http://localhost:8000
PERMITPULSE_STATE_DB=artifacts/permitpulse_state.sqlite
PERMITPULSE_REPORT_DIR=artifacts/reports
# Hosted demo only. Keep false for the local reusable-workspace experience.
PERMITPULSE_PUBLIC_DEMO=false
PERMITPULSE_RATE_LIMIT_PER_MINUTE=30
# Required only when a deployment starts without local runtime artifacts.
PERMITPULSE_ARTIFACT_BUNDLE_URL=
